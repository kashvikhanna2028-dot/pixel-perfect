{
  "manifest_version": 3,
  "name": "Expiry Radar Companion",
  "version": "0.2.0",
  "description": "Reads AI plan usage you can already see on claude.ai - usage meters on paid plans, limit/reset notices on the free plan - and syncs meter readings to your Expiry Radar dashboard. Private test build.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://exptrack.site/*",
    "https://life-expiry-guide.lovable.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/settings/usage*"
      ],
      "js": [
        "content-claude.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://exptrack.site/dashboard*",
        "https://life-expiry-guide.lovable.app/dashboard*"
      ],
      "js": [
        "content-exptrack.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/chat/*",
        "https://claude.ai/new*"
      ],
      "js": [
        "content-notice.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Expiry Radar Companion"
  }
}